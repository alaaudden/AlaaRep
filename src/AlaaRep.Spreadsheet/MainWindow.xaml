<Window x:Class="AlaaRep.Spreadsheet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AlaaRep.Spreadsheet.Controls"
        mc:Ignorable="d"
        Title="AlaaRep Spreadsheet - High Performance Excel-Like Editor"
        Height="768" Width="1180"
        FontFamily="Segoe UI" FontSize="12"
        Background="#F3F3F3">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Title bar / Quick actions -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Ribbon / Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Formula & Cell Address Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Main Spreadsheet Grid Area -->
            <RowDefinition Height="*"/>
            <!-- 4: Sheet Tabs Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 5: Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: Application Header -->
        <Border Grid.Row="0" Background="#107C41" Padding="12,8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="AlaaRep Spreadsheet" FontWeight="Bold" FontSize="14" Foreground="White" Margin="0,0,16,0"/>
                    <TextBlock Text="[No Formula Mode - High Capacity Matrix Engine]" Foreground="#C8E6C9" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="⚡ Load 100k Rows Demo" Click="BtnLoadDemo_Click"
                            Padding="8,4" Background="#185A37" Foreground="White" BorderThickness="0" Margin="4,0" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- RIBBON / TOOLBAR -->
        <Border Grid.Row="1" Background="#FBFBFB" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- File Group -->
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Button Content="📂 Import Excel/CSV" Click="BtnImportExcel_Click" Padding="8,5" Margin="2,0" Background="#FFFFFF" BorderBrush="#D1D1D1" FontWeight="SemiBold" ToolTip="Import .xlsx, .xls or .csv file"/>
                    <Button Content="💾 Export CSV" Click="BtnExportCsv_Click" Padding="8,5" Margin="2,0" Background="#FFFFFF" BorderBrush="#D1D1D1" ToolTip="Export current sheet to CSV"/>
                </StackPanel>

                <Separator Width="1" Margin="4,2" Background="#E0E0E0"/>

                <!-- Clipboard Group -->
                <StackPanel Orientation="Horizontal" Margin="6,0,12,0">
                    <Button Content="📋 Copy" Click="BtnCopy_Click" Padding="6,5" Margin="2,0" Background="#FFFFFF" BorderBrush="#D1D1D1" ToolTip="Copy selected cells (Ctrl+C)"/>
                    <Button Content="📄 Paste" Click="BtnPaste_Click" Padding="6,5" Margin="2,0" Background="#FFFFFF" BorderBrush="#D1D1D1" ToolTip="Paste from clipboard (Ctrl+V)"/>
                </StackPanel>

                <Separator Width="1" Margin="4,2" Background="#E0E0E0"/>

                <!-- Font Formatting Group -->
                <StackPanel Orientation="Horizontal" Margin="6,0,12,0">
                    <ComboBox x:Name="FontFamilyCombo" Width="110" SelectedIndex="0" Margin="2,0" SelectionChanged="FontFamilyCombo_SelectionChanged">
                        <ComboBoxItem Content="Segoe UI"/>
                        <ComboBoxItem Content="Arial"/>
                        <ComboBoxItem Content="Calibri"/>
                        <ComboBoxItem Content="Consolas"/>
                        <ComboBoxItem Content="Times New Roman"/>
                    </ComboBox>

                    <ComboBox x:Name="FontSizeCombo" Width="52" SelectedIndex="2" Margin="2,0" SelectionChanged="FontSizeCombo_SelectionChanged">
                        <ComboBoxItem Content="9"/>
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="11"/>
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="16"/>
                        <ComboBoxItem Content="18"/>
                        <ComboBoxItem Content="24"/>
                    </ComboBox>

                    <ToggleButton x:Name="BtnBold" Content="B" FontWeight="Bold" Width="26" Height="26" Margin="2,0" Click="BtnBold_Click" ToolTip="Bold"/>
                    <ToggleButton x:Name="BtnItalic" Content="I" FontStyle="Italic" Width="26" Height="26" Margin="2,0" Click="BtnItalic_Click" ToolTip="Italic"/>
                    <ToggleButton x:Name="BtnUnderline" Content="U" Width="26" Height="26" Margin="2,0" Click="BtnUnderline_Click" ToolTip="Underline"/>
                </StackPanel>

                <Separator Width="1" Margin="4,2" Background="#E0E0E0"/>

                <!-- Color Pickers -->
                <StackPanel Orientation="Horizontal" Margin="6,0,12,0">
                    <ComboBox x:Name="ColorCombo" Width="80" SelectedIndex="0" Margin="2,0" SelectionChanged="ColorCombo_SelectionChanged" ToolTip="Font Color">
                        <ComboBoxItem Content="Black" Tag="#FF000000"/>
                        <ComboBoxItem Content="Red" Tag="#FFE51400"/>
                        <ComboBoxItem Content="Blue" Tag="#FF0078D7"/>
                        <ComboBoxItem Content="Green" Tag="#FF107C41"/>
                        <ComboBoxItem Content="Orange" Tag="#FFD83B01"/>
                    </ComboBox>

                    <ComboBox x:Name="BgColorCombo" Width="95" SelectedIndex="0" Margin="2,0" SelectionChanged="BgColorCombo_SelectionChanged" ToolTip="Fill Color">
                        <ComboBoxItem Content="No Fill" Tag=""/>
                        <ComboBoxItem Content="Yellow" Tag="#FFFFF59D"/>
                        <ComboBoxItem Content="Light Blue" Tag="#FFB3E5FC"/>
                        <ComboBoxItem Content="Light Green" Tag="#FFC8E6C9"/>
                        <ComboBoxItem Content="Light Red" Tag="#FFFFCDD2"/>
                        <ComboBoxItem Content="Light Gray" Tag="#FFE0E0E0"/>
                    </ComboBox>
                </StackPanel>

                <Separator Width="1" Margin="4,2" Background="#E0E0E0"/>

                <!-- Alignment Group -->
                <StackPanel Orientation="Horizontal" Margin="6,0,12,0">
                    <Button Content="⬅" Width="26" Height="26" Margin="2,0" Click="BtnAlignLeft_Click" ToolTip="Align Left"/>
                    <Button Content="⬌" Width="26" Height="26" Margin="2,0" Click="BtnAlignCenter_Click" ToolTip="Align Center"/>
                    <Button Content="➡" Width="26" Height="26" Margin="2,0" Click="BtnAlignRight_Click" ToolTip="Align Right"/>
                </StackPanel>

                <Separator Width="1" Margin="4,2" Background="#E0E0E0"/>

                <!-- Number Formatting Group -->
                <StackPanel Orientation="Horizontal" Margin="6,0,12,0">
                    <ComboBox x:Name="FormatTypeCombo" Width="95" SelectedIndex="0" Margin="2,0" SelectionChanged="FormatTypeCombo_SelectionChanged" ToolTip="Number Formatting">
                        <ComboBoxItem Content="General"/>
                        <ComboBoxItem Content="Number"/>
                        <ComboBoxItem Content="Currency ($)"/>
                        <ComboBoxItem Content="Percentage (%)"/>
                        <ComboBoxItem Content="Short Date"/>
                    </ComboBox>
                </StackPanel>

                <Separator Width="1" Margin="4,2" Background="#E0E0E0"/>

                <!-- Clear & Row/Col Actions -->
                <StackPanel Orientation="Horizontal" Margin="6,0,4,0">
                    <Button Content="🧹 Clear" Click="BtnClear_Click" Padding="6,5" Margin="2,0" Background="#FFFFFF" BorderBrush="#D1D1D1" ToolTip="Clear cell values"/>
                    <Button Content="Auto-Fit Col" Click="BtnAutoFitCol_Click" Padding="6,5" Margin="2,0" Background="#FFFFFF" BorderBrush="#D1D1D1" ToolTip="Auto-fit column width to content"/>
                </StackPanel>

            </WrapPanel>
        </Border>

        <!-- FORMULA / CELL VALUE BAR -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D1D1D1" BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel LastChildFill="True">
                <TextBox x:Name="TxtActiveCellCoord" Width="65" IsReadOnly="True" Text="A1"
                         FontWeight="SemiBold" TextAlignment="Center" VerticalContentAlignment="Center"
                         Background="#F9F9F9" BorderBrush="#D1D1D1" Margin="0,0,6,0"/>
                <TextBlock Text="fx" FontWeight="Bold" FontStyle="Italic" Foreground="#777777" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtActiveCellValue" VerticalContentAlignment="Center" BorderBrush="#D1D1D1"
                         KeyDown="TxtActiveCellValue_KeyDown" TextChanged="TxtActiveCellValue_TextChanged"/>
            </DockPanel>
        </Border>

        <!-- MAIN SPREADSHEET GRID -->
        <controls:SpreadsheetGridControl x:Name="SpreadsheetGrid" Grid.Row="3" Background="White"/>

        <!-- SHEET TABS BAR -->
        <Border Grid.Row="4" Background="#EFEFEF" BorderBrush="#D1D1D1" BorderThickness="0,1,0,0" Padding="8,3">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Content="➕" Width="24" Height="22" Margin="0,0,6,0" Click="BtnAddSheet_Click" ToolTip="Add new sheet" Background="Transparent" BorderBrush="#BBBBBB"/>
                    <ItemsControl x:Name="SheetTabsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Margin="2,0" Padding="10,3"
                                        Click="SheetTabButton_Click" Background="White" BorderBrush="#D1D1D1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="5" Background="#107C41" Padding="8,4">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusReady" Text="Ready" Foreground="White" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock x:Name="StatusOccupied" Text="Rows: 0 | Columns: 0" Foreground="#E8F5E9" FontSize="11" Margin="0,0,16,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusSelectionStats" Text="" Foreground="White" FontSize="11" Margin="0,0,16,0"/>
                    <!-- Zoom Controls -->
                    <Button Content="-" Width="18" Height="18" Padding="0" Margin="2,0" Background="#185A37" Foreground="White" BorderThickness="0" Click="BtnZoomOut_Click" ToolTip="Zoom Out"/>
                    <Slider x:Name="ZoomSlider" Width="90" Minimum="50" Maximum="300" Value="100" Margin="4,0" ValueChanged="ZoomSlider_ValueChanged" VerticalAlignment="Center"/>
                    <Button Content="+" Width="18" Height="18" Padding="0" Margin="2,0" Background="#185A37" Foreground="White" BorderThickness="0" Click="BtnZoomIn_Click" ToolTip="Zoom In"/>
                    <TextBlock x:Name="TxtZoomLevel" Text="100%" Foreground="White" FontSize="11" Width="38" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</Window>
