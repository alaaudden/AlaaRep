<Window x:Class="AlaaRep.Takeoff.Wpf.CalibrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibrate Drawing Scale"
        Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SCALE CALIBRATION" Foreground="#38BDF8" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Drawing Distance:" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12"/>
            <TextBlock x:Name="TxtPixelDist" Grid.Column="1" Text="100.0 px" Foreground="#10B981" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Known Real Distance:" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12"/>
            <TextBox x:Name="TxtRealDist" Grid.Column="1" Text="5.0" Background="#1E293B" Foreground="White" BorderBrush="#334155" Padding="5" FontSize="13"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Distance Unit:" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12"/>
            <ComboBox x:Name="CbUnit" Grid.Column="1" Background="#1E293B" Foreground="White" BorderBrush="#334155" Height="28">
                <ComboBoxItem Content="m (Meters)" Tag="m" IsSelected="True"/>
                <ComboBoxItem Content="mm (Millimeters)" Tag="mm"/>
                <ComboBoxItem Content="cm (Centimeters)" Tag="cm"/>
                <ComboBoxItem Content="ft (Feet)" Tag="ft"/>
                <ComboBoxItem Content="in (Inches)" Tag="in"/>
            </ComboBox>
        </Grid>

        <Border Grid.Row="4" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,16">
            <TextBlock x:Name="TxtPreview" Text="100.0 px = 5.0 m (Scale Factor: 0.0500 m/px)" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="BtnCancel_Click" Background="#334155" Foreground="White" BorderThickness="0" Padding="14,6" Margin="0,0,8,0" FontSize="12"/>
            <Button Content="Apply Calibration" Click="BtnApply_Click" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="16,6" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
