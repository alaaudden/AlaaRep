<Window x:Class="AlaaRep.Takeoff.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AlaaRep Takeoff - Desktop CAD, PDF &amp; Bluebeam Studio"
        Height="850" Width="1350"
        WindowStartupLocation="CenterScreen"
        xmlns:local="clr-namespace:AlaaRep.Takeoff.Wpf"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        Background="#0F172A">

    <Window.Resources>
        <!-- High-Performance GPU-Tiled CAD Grid Pattern (Zero FrameworkElement overhead) -->
        <DrawingBrush x:Key="CadGridTileBrush" TileMode="Tile" Viewport="0,0,50,50" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#0A0F1D">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,50,50"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1E293B" Thickness="0.5"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="50,0"/>
                                <LineGeometry StartPoint="0,0" EndPoint="0,50"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Ribbon / Toolbar -->
            <RowDefinition Height="*"/>    <!-- Main Viewport & BIM Inspector -->
            <RowDefinition Height="28"/>   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Menu & Tool Ribbon -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="False">
                <!-- App Brand -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="#2563EB" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                        <TextBlock Text="AlaaRep Takeoff" Foreground="White" FontWeight="Bold" FontSize="13"/>
                    </Border>
                    <TextBlock Text="Desktop Studio" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <!-- File Operations -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,16,0">
                    <Button x:Name="BtnOpenPdf" Content="Open PDF / CAD" Click="BtnOpenPdf_Click"
                            Background="#334155" Foreground="White" BorderThickness="0" Padding="10,5" Margin="0,0,6,0"/>
                    <Button x:Name="BtnOpenBluebeam" Content="Import Bluebeam" Click="BtnOpenBluebeam_Click"
                            Background="#334155" Foreground="White" BorderThickness="0" Padding="10,5" Margin="0,0,6,0"/>
                    <Button x:Name="BtnCopy" Content="Copy (Ctrl+C)" Click="BtnCopy_Click"
                            Background="#334155" Foreground="White" BorderThickness="0" Padding="8,5" Margin="0,0,4,0"/>
                    <Button x:Name="BtnPaste" Content="Paste (Ctrl+V)" Click="BtnPaste_Click"
                            Background="#334155" Foreground="White" BorderThickness="0" Padding="8,5" Margin="0,0,6,0"/>
                    <Button x:Name="BtnLoadSample" Content="Sample Layout" Click="BtnLoadSample_Click"
                            Background="#334155" Foreground="White" BorderThickness="0" Padding="10,5" Margin="0,0,6,0"/>
                </StackPanel>

                <!-- Takeoff Tools Group -->
                <Border Background="#0F172A" CornerRadius="4" DockPanel.Dock="Left" Padding="4,2" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbSelect" Content="Select (V)" IsChecked="True" Checked="Tool_Checked"
                                     Foreground="White" Margin="6,2" VerticalAlignment="Center"/>
                        <RadioButton x:Name="RbCount" Content="Count (C)" Checked="Tool_Checked"
                                     Foreground="White" Margin="6,2" VerticalAlignment="Center"/>
                        <RadioButton x:Name="RbLength" Content="Length (L)" Checked="Tool_Checked"
                                     Foreground="White" Margin="6,2" VerticalAlignment="Center"/>
                        <RadioButton x:Name="RbArea" Content="Area (A)" Checked="Tool_Checked"
                                     Foreground="White" Margin="6,2" VerticalAlignment="Center"/>
                        <RadioButton x:Name="RbZone" Content="Zone (Z)" Checked="Tool_Checked"
                                     Foreground="#10B981" FontWeight="SemiBold" Margin="6,2" VerticalAlignment="Center"/>
                        <RadioButton x:Name="RbCalibrate" Content="Calibrate Scale" Checked="Tool_Checked"
                                     Foreground="#F59E0B" FontWeight="SemiBold" Margin="6,2" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Export & Calculate Group -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="BtnCalculateQto" Content="Calculate QTO" Click="BtnCalculateQto_Click"
                            Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="12,5" Margin="0,0,8,0"/>
                    <Button x:Name="BtnExportCsv" Content="Export CSV" Click="BtnExportCsv_Click"
                            Background="#3B82F6" Foreground="White" BorderThickness="0" Padding="10,5"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area: Drawing Viewport (Center) and BIM Inspector / Zones / QTO (Right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>         <!-- CAD/PDF Vector Viewport -->
                <ColumnDefinition Width="420"/>       <!-- Right Tabbed Panel -->
            </Grid.ColumnDefinitions>

            <!-- Center Drawing Viewport -->
            <Border Grid.Column="0" Background="#0A0F1D" ClipToBounds="True" Focusable="True">
                <Grid x:Name="ViewportGrid"
                      Background="Transparent"
                      PreviewMouseDown="Viewport_MouseDown"
                      MouseMove="Viewport_MouseMove"
                      MouseUp="Viewport_MouseUp"
                      MouseWheel="Viewport_MouseWheel">

                    <!-- Zoom & Pan Canvas Container -->
                    <Grid x:Name="CanvasContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="CanvasTranslate" X="50" Y="50"/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <!-- Grid Tile Background (Hit-test disabled so ViewportGrid catches 100% of clicks) -->
                        <Rectangle Width="5000" Height="5000" Fill="{StaticResource CadGridTileBrush}" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                        <!-- Fast Direct Drawing Surface (Hit-test disabled) -->
                        <local:FastDrawingCanvas x:Name="FastCanvas" Width="5000" Height="5000" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                        <!-- Interactive In-Progress Preview Layer (Hit-test disabled so points/rubberband never intercept clicks) -->
                        <Canvas x:Name="PreviewCanvas" Width="5000" Height="5000" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Viewport Floating HUD -->
                    <Border Background="#CC1E293B" CornerRadius="6" BorderBrush="#334155" BorderThickness="1"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Scale: " Foreground="#94A3B8" FontSize="11"/>
                            <TextBlock x:Name="TxtScaleHud" Text="1:100 (100px = 5.0m)" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Margin="0,0,12,0"/>
                            <TextBlock Text="Active Tool: " Foreground="#94A3B8" FontSize="11"/>
                            <TextBlock x:Name="TxtActiveToolHud" Text="Select / Pan" Foreground="White" FontWeight="SemiBold" FontSize="11" Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtPromptHud" Text="" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtSnapHud" Text="" Foreground="#34D399" FontWeight="Bold" FontSize="11" Margin="0,0,12,0"/>
                            <Button x:Name="BtnFinishShapeHud" Content="Finish Shape (Enter)" Click="BtnFinishShapeHud_Click" Visibility="Collapsed"
                                    Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8,2" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Viewport Zoom Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14">
                        <Button Content="+" Click="BtnZoomIn_Click" Width="30" Height="30" Background="#1E293B" Foreground="White" BorderBrush="#334155" Margin="0,0,4,0"/>
                        <Button Content="-" Click="BtnZoomOut_Click" Width="30" Height="30" Background="#1E293B" Foreground="White" BorderBrush="#334155" Margin="0,0,4,0"/>
                        <Button Content="Fit" Click="BtnZoomFit_Click" Width="36" Height="30" Background="#1E293B" Foreground="White" BorderBrush="#334155" Margin="0,0,4,0"/>
                        <Button x:Name="BtnToggleZones" Content="Zones (On)" Click="BtnToggleZones_Click" Height="30" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="#334155"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Sidebar Tabs (BIM Properties, Specific Zones, QTO Summary) -->
            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1,0,0,0">
                <TabControl Background="#1E293B" BorderThickness="0" Foreground="White">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#38BDF8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.Resources>

                    <!-- Tab 1: BIM Properties & Selected Item -->
                    <TabItem Header="BIM Inspector">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12">
                                <TextBlock Text="SELECTED OBJECT PROPERTIES" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                    <TextBox x:Name="TxtPropName" Grid.Row="0" Grid.Column="1" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="4" Margin="0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Category:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                    <TextBox x:Name="TxtPropCategory" Grid.Row="1" Grid.Column="1" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="4" Margin="0,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Type:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                    <TextBox x:Name="TxtPropType" Grid.Row="2" Grid.Column="1" Background="#0F172A" Foreground="#38BDF8" IsReadOnly="True" BorderBrush="#334155" Padding="4" Margin="0,2"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Quantity:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                    <TextBox x:Name="TxtPropQuantity" Grid.Row="3" Grid.Column="1" Background="#0F172A" Foreground="#10B981" FontWeight="Bold" IsReadOnly="True" BorderBrush="#334155" Padding="4" Margin="0,2"/>
                                </Grid>

                                <!-- BIM Properties Grid -->
                                <DockPanel Margin="0,12,0,6">
                                    <TextBlock Text="BIM / IFC ATTRIBUTES" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    <Button Content="+ Add Attribute" Click="BtnAddBimProp_Click" HorizontalAlignment="Right" Background="#334155" Foreground="White" BorderThickness="0" Padding="6,2" FontSize="11"/>
                                </DockPanel>

                                <DataGrid x:Name="DgBimProperties" AutoGenerateColumns="False" CanUserAddRows="True"
                                          Background="#0F172A" Foreground="White" RowBackground="#0F172A"
                                          BorderBrush="#334155" HeadersVisibility="Column" MinHeight="160" MaxHeight="220" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Property" Binding="{Binding Key}" Width="140"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,14">
                                    <Button x:Name="BtnDeleteObject" Content="Delete Object" Click="BtnDeleteObject_Click" Background="#EF4444" Foreground="White" BorderThickness="0" Padding="10,5" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnSaveBim" Content="Save BIM Properties" Click="BtnSaveBim_Click" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="12,5"/>
                                </StackPanel>

                                <!-- Objects List -->
                                <TextBlock Text="TAKEOFF OBJECTS" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                <ListBox x:Name="LbTakeoffObjects" SelectionChanged="LbTakeoffObjects_SelectionChanged"
                                         Background="#0F172A" Foreground="White" BorderBrush="#334155" Height="180">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#94A3B8" FontSize="11"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Specific Zones -->
                    <TabItem Header="Specific Zones">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="DEFINED ZONES ON LAYOUT" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>

                            <ListBox x:Name="LbZones" Grid.Row="1" SelectionChanged="LbZones_SelectionChanged"
                                     Background="#0F172A" Foreground="White" BorderBrush="#334155">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Code}" Foreground="#10B981" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="Polygon Zone" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button x:Name="BtnDeleteZone" Content="Delete Zone" Click="BtnDeleteZone_Click" Background="#EF4444" Foreground="White" BorderThickness="0" Padding="10,5" Margin="0,0,8,0"/>
                                <Button Content="+ Draw New Zone" Click="BtnStartDrawZone_Click" Background="#10B981" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Padding="12,5"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Tab 3: QTO Summary Table -->
                    <TabItem Header="QTO Report">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Grand Totals Cards -->
                            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,10">
                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="Total Counts" Foreground="#94A3B8" FontSize="10"/>
                                        <TextBlock x:Name="TxtGrandCount" Text="0" Foreground="White" FontWeight="Bold" FontSize="16"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2,0,2,0">
                                    <StackPanel>
                                        <TextBlock Text="Total Length" Foreground="#94A3B8" FontSize="10"/>
                                        <TextBlock x:Name="TxtGrandLength" Text="0.00 m" Foreground="#38BDF8" FontWeight="Bold" FontSize="16"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8" Margin="4,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Total Area" Foreground="#94A3B8" FontSize="10"/>
                                        <TextBlock x:Name="TxtGrandArea" Text="0.00 m²" Foreground="#10B981" FontWeight="Bold" FontSize="16"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Detailed Zone Breakdown Table -->
                            <DataGrid x:Name="DgQtoReport" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#0F172A" Foreground="White" RowBackground="#0F172A" BorderBrush="#334155">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="130"/>
                                    <DataGridTextColumn Header="Zone" Binding="{Binding ZoneName}" Width="100"/>
                                    <DataGridTextColumn Header="Quantity" Binding="{Binding QuantityStr}" Width="90"/>
                                    <DataGridTextColumn Header="Total Cost" Binding="{Binding CostStr}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Grid.Row="2" Content="Export QTO to CSV" Click="BtnExportCsv_Click"
                                    Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="10,6" Margin="0,10,0,0"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="#94A3B8" FontSize="11" DockPanel.Dock="Left"/>
                <TextBlock x:Name="TxtCursorCoords" Text="X: 0, Y: 0" Foreground="#64748B" FontSize="11" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
