<UserControl x:Class="AlaaRep.Xer.Wpf.Controls.TaskDetailTabsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="260" d:DesignWidth="900"
             Background="#F8F9FA" FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="DetailInput" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Header banner showing selected entity -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E9ECEF" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Selected Node: " FontWeight="Bold" Foreground="#212529"/>
                <TextBlock Text="{Binding SelectedScheduleNode.Code, FallbackValue='None'}" FontWeight="Bold" Foreground="#0D6EFD" Margin="0,0,6,0"/>
                <TextBlock Text="-" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding SelectedScheduleNode.Name, FallbackValue='No task or WBS selected'}" FontWeight="SemiBold" Foreground="#343A40"/>
                <TextBlock Text=" [" Margin="6,0,0,0"/>
                <TextBlock Text="{Binding SelectedScheduleNode.ItemType}" FontWeight="SemiBold" Foreground="#6C757D"/>
                <TextBlock Text="]"/>
            </StackPanel>
        </Border>

        <!-- Bottom Tabs like Primavera P6 Detail Windows -->
        <TabControl Grid.Row="1" Background="#FFFFFF" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Margin="0">
            <!-- TAB 1: GENERAL -->
            <TabItem Header="📌 General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16,12" IsEnabled="{Binding HasSelectedNode}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Activity ID:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedScheduleNode.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInput}"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Activity Name:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding SelectedScheduleNode.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInput}"/>

                        <!-- Row 1 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="WBS Code:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedScheduleNode.WbsCode, Mode=OneWay}" IsReadOnly="True" Background="#E9ECEF" Style="{StaticResource DetailInput}"/>

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="WBS Name:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding SelectedScheduleNode.WbsName, Mode=OneWay}" IsReadOnly="True" Background="#E9ECEF" Style="{StaticResource DetailInput}"/>

                        <!-- Row 2 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Activity Type:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedActivity.TaskType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue='Summary'}" Style="{StaticResource DetailInput}"/>

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Status:" Style="{StaticResource DetailLabel}"/>
                        <ComboBox Grid.Row="2" Grid.Column="4"
                                  SelectedItem="{Binding SelectedScheduleNode.StatusDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center" Height="28">
                            <ComboBox.ItemsSource>
                                <x:Array Type="{x:Type sys:String}">
                                    <sys:String>Not Started</sys:String>
                                    <sys:String>In Progress</sys:String>
                                    <sys:String>Completed</sys:String>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>

                        <!-- Row 3 -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Critical:" Style="{StaticResource DetailLabel}"/>
                        <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding SelectedScheduleNode.IsCritical, Mode=OneWay}" IsEnabled="False" Content="On Critical Path (Float &lt;= 0)" VerticalAlignment="Center"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: STATUS & PROGRESS -->
            <TabItem Header="📊 Status &amp; Progress">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16,12" IsEnabled="{Binding HasSelectedNode}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Physical % Complete:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedActivity.PhysicalPercentComplete, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N1}}" Style="{StaticResource DetailInput}"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Overall % Complete:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding SelectedScheduleNode.PercentComplete, Mode=OneWay, StringFormat={}{0:N1}%}" IsReadOnly="True" Background="#E9ECEF" Style="{StaticResource DetailInput}"/>

                        <!-- Row 1 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Actual Start Date:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedActivity.ActualStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInput}"/>

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Actual Finish Date:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding SelectedActivity.ActualEndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInput}"/>

                        <!-- Row 2 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Actual Duration (Hrs):" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedActivity.ActualDurationHours, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DetailInput}"/>

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Remaining (Hrs):" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding SelectedActivity.RemainingDurationHours, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DetailInput}"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: DATES -->
            <TabItem Header="📅 Dates">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16,12" IsEnabled="{Binding HasSelectedNode}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Planned -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Planned Start:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedActivity.TargetStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInput}"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Planned Finish:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding SelectedActivity.TargetEndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInput}"/>

                        <!-- Row 1: Early -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Early Start:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedActivity.EarlyStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInput}"/>

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Early Finish:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding SelectedActivity.EarlyEndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInput}"/>

                        <!-- Row 2: Rollup / Formatted -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Effective Start:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedScheduleNode.FormattedStartDate, Mode=OneWay}" IsReadOnly="True" Background="#E9ECEF" Style="{StaticResource DetailInput}"/>

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Effective Finish:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding SelectedScheduleNode.FormattedEndDate, Mode=OneWay}" IsReadOnly="True" Background="#E9ECEF" Style="{StaticResource DetailInput}"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: DURATIONS & FLOAT -->
            <TabItem Header="⏱ Durations &amp; Float">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16,12" IsEnabled="{Binding HasSelectedNode}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Planned Duration (Days):" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedActivity.TargetDurationDays, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N1}}" Style="{StaticResource DetailInput}"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Planned Hours:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding SelectedActivity.TargetDurationHours, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N1}}" Style="{StaticResource DetailInput}"/>

                        <!-- Row 1 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Remaining Days:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedScheduleNode.RemainingDays, Mode=OneWay, StringFormat={}{0:N1}}" IsReadOnly="True" Background="#E9ECEF" Style="{StaticResource DetailInput}"/>

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Total Float (Hours):" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding SelectedActivity.TotalFloatHours, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N1}}" Style="{StaticResource DetailInput}"/>

                        <!-- Row 2 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Schedule Duration Days:" Style="{StaticResource DetailLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedScheduleNode.DurationDays, Mode=OneWay, StringFormat={}{0:N1}}" IsReadOnly="True" Background="#E9ECEF" Style="{StaticResource DetailInput}"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: RELATIONSHIPS -->
            <TabItem Header="🔗 Relationships">
                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Predecessors -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="⬅ Predecessors" FontWeight="Bold" Margin="0,0,0,6" Foreground="#0D6EFD"/>
                        <DataGrid ItemsSource="{Binding Predecessors}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  BorderBrush="#DEE2E6"
                                  AlternatingRowBackground="#F9FAFB">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Activity ID" Binding="{Binding RelatedTaskCode}" FontWeight="SemiBold" Width="90"/>
                                <DataGridTextColumn Header="Activity Name" Binding="{Binding RelatedTaskName}" Width="*"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplayName}" Width="140"/>
                                <DataGridTextColumn Header="Lag (Days)" Binding="{Binding LagDays, StringFormat={}{0:N1}}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DEE2E6"/>

                    <!-- Successors -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="➡ Successors" FontWeight="Bold" Margin="0,0,0,6" Foreground="#198754"/>
                        <DataGrid ItemsSource="{Binding Successors}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  BorderBrush="#DEE2E6"
                                  AlternatingRowBackground="#F9FAFB">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Activity ID" Binding="{Binding RelatedTaskCode}" FontWeight="SemiBold" Width="90"/>
                                <DataGridTextColumn Header="Activity Name" Binding="{Binding RelatedTaskName}" Width="*"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplayName}" Width="140"/>
                                <DataGridTextColumn Header="Lag (Days)" Binding="{Binding LagDays, StringFormat={}{0:N1}}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- TAB 6: RAW RECORD ATTRIBUTES -->
            <TabItem Header="⚙ Raw Row Fields">
                <Grid Margin="12,8">
                    <DataGrid ItemsSource="{Binding SelectedRowAttributes}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              AlternatingRowBackground="#F9FAFB"
                              BorderBrush="#DEE2E6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Field Name (%F)" Binding="{Binding Key}" FontWeight="SemiBold" Width="220"/>
                            <DataGridTextColumn Header="Field Value (%R)" Binding="{Binding Value}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
