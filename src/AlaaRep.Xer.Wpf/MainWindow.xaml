<Window x:Class="AlaaRep.Xer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlaaRep.Xer.Wpf"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="750" Width="1180"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Background="#F4F6F9">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Style definitions -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0D6EFD"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#0B5ED7"/>
        <SolidColorBrush x:Key="DarkBg" Color="#212529"/>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="#0D6EFD"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0D6EFD"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Ribbon -->
            <RowDefinition Height="*"/>    <!-- Main Workspace -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Ribbon / Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📂 Open XER" Command="{Binding OpenCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="💾 Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Content="💾 Save As..." Command="{Binding SaveAsCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="⚡ Load Sample" Command="{Binding LoadSampleCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Separator Width="1" Margin="6,2,14,2" Background="#DEE2E6"/>
                    <Button Content="➕ Add Activity" Command="{Binding AddActivityCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="🗑 Delete Activity" Command="{Binding DeleteActivityCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>

                <!-- Project Title Editor -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Project Name:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#495057"/>
                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Width="260" Padding="6,4"
                             BorderBrush="#CED4DA" Background="#F8F9FA"/>
                </StackPanel>

                <!-- Search box -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍 Filter:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#6C757D"/>
                    <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" Width="180" Padding="6,4"
                             BorderBrush="#CED4DA" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace (Tab Control) -->
        <TabControl Grid.Row="1" Background="#FFFFFF" BorderThickness="0" Margin="10">
            <!-- TAB 1: CURATED ACTIVITY SCHEDULE VIEW -->
            <TabItem Header="📋 Activity Schedule Editor">
                <Grid Margin="6">
                    <DataGrid ItemsSource="{Binding Activities}"
                              SelectedItem="{Binding SelectedActivity, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              AlternatingRowBackground="#F9FAFB"
                              RowBackground="#FFFFFF"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E9ECEF"
                              BorderBrush="#DEE2E6"
                              BorderThickness="1"
                              FontSize="13"
                              RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Activity ID" Binding="{Binding TaskCode, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" Width="100"/>
                            <DataGridTextColumn Header="Activity Name" Binding="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}" Width="260"/>
                            <DataGridComboBoxColumn Header="Status"
                                                    SelectedItemBinding="{Binding StatusDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="120">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="{x:Type sys:String}">
                                        <sys:String>Not Started</sys:String>
                                        <sys:String>In Progress</sys:String>
                                        <sys:String>Completed</sys:String>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="% Complete" Binding="{Binding PhysicalPercentComplete, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N1}%}" Width="100"/>
                            <DataGridTextColumn Header="Planned Days" Binding="{Binding TargetDurationDays, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N1}}" Width="100"/>
                            <DataGridTextColumn Header="Planned Start" Binding="{Binding TargetStartDate, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                            <DataGridTextColumn Header="Planned Finish" Binding="{Binding TargetEndDate, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                            <DataGridTextColumn Header="Actual Start" Binding="{Binding ActualStartDate, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                            <DataGridTextColumn Header="Actual Finish" Binding="{Binding ActualEndDate, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                            <DataGridTextColumn Header="Total Float (Hrs)" Binding="{Binding TotalFloatHours, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: RAW XER TABLES AND FIELDS INSPECTOR -->
            <TabItem Header="🗄 All Tables &amp; Raw XER Inspector">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Table List -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Tables in XER" FontWeight="Bold" Margin="0,0,0,8" Foreground="#495057"/>
                        <ListBox ItemsSource="{Binding Tables}"
                                 SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                                 DisplayMemberPath="Name"
                                 BorderBrush="#DEE2E6"
                                 SelectionMode="Single"/>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DEE2E6"/>

                    <!-- Right: Table Records & Dynamic Fields -->
                    <DockPanel Grid.Column="2" Margin="8,0,0,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding SelectedTable.Name, FallbackValue='No Table Selected'}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text=" - Record Rows (%R)" Margin="6,0,16,0" VerticalAlignment="Center" Foreground="#6C757D"/>
                            <Button Content="➕ Add Table Row" Command="{Binding AddTableRowCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                            <Button Content="🗑 Delete Table Row" Command="{Binding DeleteTableRowCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                        </StackPanel>

                        <!-- Dynamically populated or bound via code-behind in MainWindow.xaml.cs -->
                        <DataGrid x:Name="RawTableDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  SelectedItem="{Binding SelectedRawRow, Mode=TwoWay}"
                                  AlternatingRowBackground="#F9FAFB"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E9ECEF"
                                  BorderBrush="#DEE2E6"
                                  BorderThickness="1"
                                  FontSize="12"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#E9ECEF" Padding="10,6">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#495057"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
